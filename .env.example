APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local development: emails are caught by Mailpit (inbox at http://localhost:8025).
# On the live server, switch these to the real email service (e.g. Resend).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@equiptrack.test"
MAIL_FROM_NAME="EquipTrack"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Penalties (EquipTrack only records them; payment happens outside the system)
# Suggested late fee per day when recording a Late Return penalty (0 = no suggestion)
PENALTY_LATE_PER_DAY=0
# Students/faculty with a Pending penalty cannot submit new borrow requests
BLOCK_BORROWING_WITH_PENDING_PENALTY=true

# Borrowing schedule (Philippine time, 24-hour HH:MM)
# Office hours shown on the request form; RETURN_DEADLINE defaults to LAB_CLOSES
LAB_OPENS=07:00
LAB_CLOSES=19:00
# RETURN_DEADLINE=19:00
# Days the equipment office is open, and how far ahead a borrow date may be
OFFICE_DAYS=Mon,Tue,Wed,Thu,Fri,Sat
MAX_ADVANCE_DAYS=30
# Most units per request for non-Expensive equipment (0 = only stock limits it)
MAX_UNITS_PER_REQUEST=0

# Deployment
# MySQL session time zone: keeps dates MySQL fills in (request dates, audit
# times) in Philippine time on servers that run on UTC, e.g. Hostinger
DB_TIMEZONE=+08:00
# Behind Cloudflare or another HTTPS proxy set to * (empty = no proxy)
TRUSTED_PROXIES=

# Backups (php artisan equiptrack:backup, daily at BACKUP_TIME)
# Save them on another drive or a cloud-synced folder, not only on this disk
# BACKUP_PATH=D:\EquipTrack-backups
# Days to keep old backups (0 = keep all)
BACKUP_KEEP_DAYS=14
BACKUP_TIME=19:30
# Full path when mysqldump is not on the PATH (Laragon), e.g.
# BACKUP_MYSQLDUMP="C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin\mysqldump.exe"
