# ============================================================================
# EquipTrack — .env for the LIVE server (e.g. Hostinger)
# ----------------------------------------------------------------------------
# Copy this file to .env on the server and fill in every value marked CHANGE.
# Never upload your local .env, and never commit the real production .env.
# After editing .env on the server, run:
#     php artisan config:cache
#     php artisan equiptrack:check-production
# ============================================================================

APP_NAME=EquipTrack
# Production mode: HTTPS is forced, debug pages are off, session cookies are
# secure (see app/Providers/AppServiceProvider.php and RedirectToHttps).
APP_ENV=production
# CHANGE: run "php artisan key:generate" on the server once (fills this in).
APP_KEY=
# Must stay false online: debug pages show code, settings and passwords.
APP_DEBUG=false
# CHANGE: your real address, with https://
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Errors are logged to storage/logs (not shown to visitors). "warning" keeps
# the log small; use "debug" only while investigating a problem.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# CHANGE: the MySQL database you create in hPanel (Databases > MySQL).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_database_name
DB_USERNAME=CHANGE_database_user
DB_PASSWORD=CHANGE_database_password
# Keeps dates MySQL fills in (request dates, audit times) in Philippine time on
# servers that run on UTC, such as Hostinger.
DB_TIMEZONE=+08:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Session data stored encrypted in the database.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# The session cookie is only sent over HTTPS (also the default in production).
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# CHANGE: a real mailbox for reminder and password-reset emails, e.g. an email
# account created in hPanel (Emails), or Gmail with an App Password.
# Hostinger email: host smtp.hostinger.com, port 465, scheme smtps.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=CHANGE_no-reply@your-domain.com
MAIL_PASSWORD=CHANGE_mailbox_password
MAIL_FROM_ADDRESS="CHANGE_no-reply@your-domain.com"
MAIL_FROM_NAME="EquipTrack"

# Penalties (EquipTrack only records them; payment happens outside the system)
PENALTY_LATE_PER_DAY=0
BLOCK_BORROWING_WITH_PENDING_PENALTY=true

# Borrowing schedule (Philippine time, 24-hour HH:MM)
LAB_OPENS=07:00
LAB_CLOSES=19:00
# RETURN_DEADLINE=19:00
OFFICE_DAYS=Mon,Tue,Wed,Thu,Fri,Sat
MAX_ADVANCE_DAYS=30
MAX_UNITS_PER_REQUEST=0

# Leave empty on Hostinger. Only if you put the site behind Cloudflare (or
# turn on a proxy/CDN that terminates HTTPS) set this to * so Laravel can see
# that visitors use https.
TRUSTED_PROXIES=

# Backups (php artisan equiptrack:backup, daily at BACKUP_TIME)
# Save them on another drive or a cloud-synced folder, not only on this disk
# BACKUP_PATH=D:\EquipTrack-backups
# Days to keep old backups (0 = keep all)
BACKUP_KEEP_DAYS=14
BACKUP_TIME=19:30
# Full path when mysqldump is not on the PATH (Laragon), e.g.
# BACKUP_MYSQLDUMP="C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin\mysqldump.exe"
